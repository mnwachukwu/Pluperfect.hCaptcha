# --- .NET ------------------------------------------------------------------
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo
artifacts/

# --- Test and coverage output ----------------------------------------------
[Tt]est[Rr]esult*/
*.coverage
*.coveragexml

# --- Secrets ---------------------------------------------------------------
# Nothing in this repository needs a secret. The hCaptcha secret key is read from
# the consuming deployment's own configuration on its own box, so a credential
# appearing here is a mistake rather than a file to be ignored.
appsettings.Production.json
*.env

# --- Not ignored, deliberately ---------------------------------------------
# packages.lock.json IS committed. RestorePackagesWithLockFile is on and CI
# restores locked, so the lock file is what makes a restore reproducible.

# --- Client package --------------------------------------------------------
# Built output. Consumers take it by file: dependency and build it themselves;
# committing it would mean reviewing compiler output in every pull request.
client/dist/
client/node_modules/
